# Data source used by the API: "postgres" or "synthetic".
# Keep the real DATABASE_URL only in .env.local or the hosting provider's secrets.
DATA_SOURCE="synthetic"
DATABASE_URL=""
DATABASE_SSL="true"

# Supabase Auth (the project base URL must not include /rest/v1/).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Public app URL used in customer email buttons.
APP_URL="http://localhost:3000"

# Databricks live synchronization (Delta table -> MarketOps/PostgreSQL).
# Keep DATABRICKS_TOKEN only in .env.local or the hosting provider secret store.
DATABRICKS_SYNC_ENABLED="false"
DATABRICKS_HOST=""
DATABRICKS_TOKEN=""
# Prefer the warehouse ID. DATABRICKS_HTTP_PATH is also accepted if it contains /warehouses/<id>.
DATABRICKS_WAREHOUSE_ID=""
DATABRICKS_HTTP_PATH=""
DATABRICKS_CATALOG="main"
DATABRICKS_SCHEMA="marketops"
DATABRICKS_TABLE="orders_live"
DATABRICKS_POLL_INTERVAL_MS="10000"
# Browser refresh. The API itself also throttles Databricks queries using the interval above.
VITE_LIVE_REFRESH_MS="10000"
# Secret for optional service-to-service calls to POST /api/databricks/reconcile.
DATABRICKS_WEBHOOK_SECRET=""

# Report + delivery alert email through SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Optional verified Gmail/Workspace aliases, separated by semicolons.
SMTP_ALLOWED_FROM_ADDRESSES=""
SMTP_CONNECTION_TIMEOUT_MS="10000"

# Optional: real mailbox that receives alerts generated for synthetic @example.com contacts.
# Useful for demos without replacing the fake customer data in the UI.
DEMO_ALERT_RECIPIENT=""

# Recommended email provider on Render Free (HTTPS API)
RESEND_API_KEY=""
RESEND_FROM="MarketOps <onboarding@resend.dev>"

# Data source used by the API: "postgres" or "synthetic".
# Keep the real DATABASE_URL only in .env.local or the hosting provider's secrets.
DATA_SOURCE="synthetic"
DATABASE_URL=""
DATABASE_SSL="true"

# Supabase Auth (the project base URL must not include /rest/v1/).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional Databricks Logistics Connection
DATABRICKS_HOST=""
DATABRICKS_TOKEN=""
DATABRICKS_HTTP_PATH=""

# Optional report delivery through SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
